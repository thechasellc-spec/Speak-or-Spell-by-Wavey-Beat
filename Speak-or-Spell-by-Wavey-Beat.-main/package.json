{
  "name": "speak-or-spell-wavey-beat",
  "version": "6.0.0",
  "description": "Speak or Spell by Wavey Beat — branded AI singing studio with local vocal-engine integration",
  "main": "main.js",
  "author": "Wavey Beat",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg zip --x64 --publish never",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "25.9.8",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.waveybeat.speakorspell",
    "productName": "Speak or Spell by Wavey Beat",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "package.json",
      "singer-core.js",
      "neural-engine/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "public.app-category.music"
    },
    "win": {
      "target": "nsis"
    },
    "asarUnpack": [
      "neural-engine/**/*"
    ],
    "dmg": {
      "title": "Speak or Spell by Wavey Beat — AI Singing Studio",
      "artifactName": "Speak-or-Spell-by-Wavey-Beat-${version}-Intel-Mac.${ext}"
    },
    "artifactName": "Speak-or-Spell-by-Wavey-Beat-${version}-${arch}.${ext}"
  }
}
